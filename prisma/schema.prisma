generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  role         String
  passwordHash String
  createdAt    DateTime @default(now())
}

model Project {
  id            String   @id @default(cuid())
  name          String
  referenceCode String   @unique
  pillar        String
  status        String   @default("active")
  createdAt     DateTime @default(now())
  links   SecureLink[]
  uploads Upload[]
}

model SecureLink {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  revokedAt    DateTime?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  uploads Upload[]
}

model Upload {
  id               String   @id @default(cuid())
  originalFilename String
  mimeType         String
  size             Int
  storageKey       String
  uploaderName     String
  uploaderEmail    String
  notes            String?
  uploaderIp       String?
  userAgent        String?
  uploadedAt       DateTime @default(now())
  linkId  String
  link    SecureLink @relation(fields: [linkId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorType String
  actorId   String?
  action    String
  metadata  String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}
